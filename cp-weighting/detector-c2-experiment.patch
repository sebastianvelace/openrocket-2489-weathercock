+	private double smallAngleNaturalFrequency(SimulationStatus status, FlightDataBranch branch) {
+		double mach = branch.getLast(FlightDataType.TYPE_MACH_NUMBER);
+		double sound = branch.getLast(FlightDataType.TYPE_SPEED_OF_SOUND);
+		double rho = branch.getLast(FlightDataType.TYPE_AIR_DENSITY);
+		double cg = branch.getLast(FlightDataType.TYPE_CG_LOCATION);
+		double inertia = branch.getLast(FlightDataType.TYPE_LONGITUDINAL_INERTIA);
+		if (Double.isNaN(mach) || mach <= 0 || !(inertia > 0)) {
+			return Double.NaN;
+		}
+		if (smallAngleCalc == null) {
+			smallAngleCalc = new info.openrocket.core.aerodynamics.BarrowmanCalculator();
+		}
+		info.openrocket.core.aerodynamics.FlightConditions fc =
+				new info.openrocket.core.aerodynamics.FlightConditions(status.getConfiguration());
+		fc.setMach(mach);
