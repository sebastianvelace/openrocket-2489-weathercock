+		info.openrocket.core.aerodynamics.AerodynamicForces f = smallAngleCalc.getAerodynamicForces(
+				status.getConfiguration(), fc, new WarningSet());
+		double v = mach * sound;
+		double ccm = 0.5 * rho * v * v * fc.getRefArea() * f.getCP().getWeight() * (f.getCP().getX() - cg);
+		return ccm > 0 ? Math.sqrt(ccm / inertia) : Double.NaN;
+	}
